{
  "name": "luxor",
  "private": true,
  "version": "0.1.0",
  "description": "Luxor — an open-source desktop cockpit for AI-assisted coding",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test src",
    "e2e": "playwright test",
    "tauri": "tauri",
    "bench": "bun bench/bench.ts",
    "bench:editor": "bun src/perf/editorBench.ts",
    "bundle:analyze": "ANALYZE=1 bun run build && bun scripts/bundle-analysis.ts"
  },
